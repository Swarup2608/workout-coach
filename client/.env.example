# URL of the Express API (local dev: call it directly)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production on Vercel (separate web + API projects on *.vercel.app):
# proxy the API through this app so auth cookies are first-party — see next.config.ts.
# NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://starkfitiq-api.vercel.app

