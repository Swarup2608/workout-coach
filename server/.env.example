# ── Claude API ──────────────────────────────────────────────
# Paste your key from https://console.anthropic.com/ here.
# Leave it empty to run in offline mode (deterministic scoring, no chat).
ANTHROPIC_API_KEY=

# Model used for scoring and chat
CLAUDE_MODEL=claude-sonnet-5-5

# ── Server ──────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATA_FILE=./data/db.json
