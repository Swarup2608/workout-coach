# ── MongoDB Atlas ───────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=starkfitiq

# ── Secrets (generate with: npm run secrets -w server) ──────
# Two different random strings, 32+ characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 random bytes (64 hex chars). Encrypts each user's AI API key in the database.
# Changing it makes saved AI keys unreadable (users would need to re-enter them).
ENCRYPTION_KEY=

# ── Token lifetimes (seconds) ───────────────────────────────
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# ── Server ──────────────────────────────────────────────────
PORT=4000
# Browser origin(s) of the Next.js app, comma separated
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── Cookies ─────────────────────────────────────────────────
# lax: client and API on the same site (localhost:3000 + localhost:4000, app.example.com + api.example.com)
# none: client and API on different sites (needs HTTPS + COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# Set true behind a reverse proxy / PaaS so rate limits see real client IPs
TRUST_PROXY=false

# Allow "Custom" AI base URLs on localhost/private networks (e.g. Ollama at http://localhost:11434/v1).
# Keep false in production (prevents SSRF into your network).
ALLOW_PRIVATE_AI_URLS=false

# ── Email (Resend: https://resend.com → API Keys) ───────────
# Leave RESEND_API_KEY empty in development: emails (verification, password reset) are printed
# in the server terminal instead, so you can click the links from there. Required in production.
RESEND_API_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=StarkFitIQ <onboarding@resend.dev>
# Public web app URL used in email links (defaults to the first CLIENT_ORIGIN)
# APP_URL=https://app.example.com
# Lock the app until users click the verification link (sign-in still works)
REQUIRE_EMAIL_VERIFICATION=true

# AI API keys are NOT configured here: each user adds their own in Profile → AI provider.
